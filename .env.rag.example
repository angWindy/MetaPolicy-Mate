# =============================================================================
# .env.rag.example - TEMPLATE for the standalone RAG & database module
# -----------------------------------------------------------------------------
# Copy this file to `.env.rag` and fill in real values for production use.
# `.env.rag` is in .gitignore - never commit secrets.
#
# Loading order in src/rag/config.py: real env vars > .env.rag > .env
#
# IMPORTANT: do NOT write inline `#` comments on the same line as a KEY=value;
# pydantic-settings will treat the comment as part of the value.
#
# This file mirrors the structure of `.env.rag` 1:1; only secret values
# (API keys, URLs with credentials) are blanked out.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=AI20K Agent
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DEV_AUTH_BYPASS=true

# -----------------------------------------------------------------------------
# Multi-provider LLM
# -----------------------------------------------------------------------------
# Pick one of: template | openai | anthropic | gemini | mistral | ollama
# `template` is the safe offline default - it composes answers from the
# retrieved chunks without calling any external LLM. Use it as fallback.
GENERATOR_PROVIDER=template
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG=

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Pick one of: hash | openai | gemini | sentence_transformers | ollama
# - hash: offline deterministic (256 dims), no key required - DEFAULT for dev
# - openai: text-embedding-3-small/large, requires OPENAI_API_KEY
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=1
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# Sparse embeddings (BM25-style, hashed-lexical is the only supported impl)
SPARSE_EMBEDDING_PROVIDER=hashed
SPARSE_EMBEDDING_MODEL=hashed-lexical
SPARSE_EMBEDDING_VERSION=1

# -----------------------------------------------------------------------------
# Streaming / Retry / Fallback
# -----------------------------------------------------------------------------
STREAMING_ENABLED=false
LLM_MAX_RETRIES=3
LLM_FALLBACK_PROVIDERS=ollama,template
EMBEDDING_MAX_RETRIES=3
EMBEDDING_FALLBACK_PROVIDERS=hash

# -----------------------------------------------------------------------------
# Storage / Database
# -----------------------------------------------------------------------------
DATA_DIR=./data
# `DATABASE_URL` is shared by both backend (.env) and RAG module (.env.rag).
# Production must point at a real Postgres instance (Neon is fine).
# Use `sqlite:///./data/app.db` only for offline experimentation; note that
# rag_legacy schema is provisioned against Postgres on first run.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Vector store (Qdrant)
# -----------------------------------------------------------------------------
# `memory` = in-process fallback (no external service, no persistence)
# `qdrant` = real Qdrant; set QDRANT_URL accordingly
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=p234_qdrant

# -----------------------------------------------------------------------------
# Reranker
# -----------------------------------------------------------------------------
# `cross_encoder`     = BAAI/bge-reranker-v2-m3 (GPU recommended)
# `lexical_fallback`  = token overlap; no model download; used as fallback
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=ef6343e0838fa68e275959461b0140b39f264eb0
RERANKER_DEVICE=cpu
RERANKER_BACKEND=torch
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_TIMEOUT_SECONDS=30.0
RERANKER_CIRCUIT_FAILURE_THRESHOLD=3
RERANKER_CIRCUIT_COOLDOWN_SECONDS=60.0
RERANK_CANDIDATE_LIMIT=60
RERANK_PRE_DIVERSITY_LIMIT=20
RERANK_MMR_LAMBDA=0.85

# -----------------------------------------------------------------------------
# Retrieval tuning
# -----------------------------------------------------------------------------
SEMANTIC_TOP_K=20
KEYWORD_TOP_K=20
FUSED_LIMIT=60
MAX_CHUNKS_PER_DOCUMENT=4
NEAR_DUPLICATE_SIMILARITY_THRESHOLD=0.95
RRF_K=60
RRF_ALPHA=0.3
FINAL_TOP_K=12
FINAL_CONTEXT_LIMIT=5
FINAL_MAX_CHUNKS_PER_DOCUMENT=2
CONTEXT_TOKEN_BUDGET=3000
CONTEXT_MAX_REFERENCED_DEFINITIONS=3
MINIMUM_EVIDENCE_SCORE=0.05
EXPIRY_WARNING_DAYS=30
RETRIEVAL_LEG_TIMEOUT_SECONDS=5.0

# -----------------------------------------------------------------------------
# Chunking
# -----------------------------------------------------------------------------
CHUNK_MAX_CHARS=2200
CHUNK_OVERLAP_CHARS=250

# -----------------------------------------------------------------------------
# Parser (PDF/DOCX/TXT ingestion)
# -----------------------------------------------------------------------------
# auto: routes <stem>-table.pdf through pypdf_table and others through pypdf.
PARSER_BACKEND=auto
DOCLING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true
MAX_UPLOAD_MB=50

# -----------------------------------------------------------------------------
# Observability (informational only — do not modify these)
# -----------------------------------------------------------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
