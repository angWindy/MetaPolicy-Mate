# =============================================================================
# .env.example - TEMPLATE for the backend service (GITIGNORE-safe)
# -----------------------------------------------------------------------------
# Copy to `.env` and keep all real secrets out of Git.
#
# Single shared DATABASE_URL drives both layers:
#   * Backend (src/config.py)     -> schema `public`  (clean-arch UC tables)
#   * RAG      (src/rag/config.py) -> schema `rag_legacy` (legacy chunks)
# Both can target the same Neon cluster; src/db/session.py applies
# `schema_translate_map={"None": "rag_legacy"}` so the two schemas never
# collide in the same database.
#
# Tenant identity (school_id / school_code) is hardcoded in src/config.py
# because the demo is single-tenant. Role/permission is resolved from
# the `school_code` collected on the registration form (RBAC identity),
# not from these constants.
#
# Loading order: real env vars > .env > .env.rag
# (so OPENAI_API_KEY set in .env.rag will be visible to backend too)
# =============================================================================

# --- LLM provider keys -------------------------------------------------------
OPENAI_API_KEY=

# --- Database (shared by backend + RAG) --------------------------------------
# Neon Postgres connection string. This DB holds both the clean-architecture
# UC tables (public schema) and the legacy RAG tables (rag_legacy schema).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# --- Redis (rate limiter + token-version cache) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- App runtime -------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO
DEV_AUTH_BYPASS=true

# --- AI log transport (informational only — do not modify these) -------------
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# --- Cloudflare R2 (file storage) -------------------------------------------
# When these are left blank, src/infrastructure/dependency_injection
# falls back to LocalFileStorage (data/storage/) for offline demos.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- JWT auth ----------------------------------------------------------------
JWT_ISSUER=p234-frontend
JWT_AUDIENCE=p234-api
JWT_SECRET_KEY=change-me-to-a-random-32-byte-string
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- OCR / PDF processing ----------------------------------------------------
# Hybrid text-extract gate — pages whose PyMuPDF text layer returns at least
# this many characters bypass OCR even when the page classifier labelled them
# SCAN/HYBRID. Set to empty or 0 to disable the override (revert to the
# legacy classifier-only behaviour).
# Default: 50
OCR_HYBRID_TEXT_THRESHOLD=50

# Per-page OCR confidence threshold for the ``low_confidence`` audit flag.
# Pages whose average OCR confidence falls below this number are flagged so
# downstream ``extract_sections(ocr_mode=True)`` routes them through the
# semantic-chunking fallback (no regex heading detection on noise).
# 0.5 surfaces more pages as low-confidence; 0.7 is permissive.
# Default: 0.5
OCR_LOW_CONFIDENCE_THRESHOLD=0.5

# Vietnamese recognition model directory. Searched in this order:
#   1. $OCR_MODELS_DIR/rec_vi  (default ./ocr_models/rec_vi)
#   2. data/ocr/outputs/onnx_models/rec_vi  (dev workspace fallback)
OCR_MODELS_DIR=ocr_models

# --- RAG evidence thresholds -------------------------------------------------
# Optional overrides for src/rag/config.py defaults. Lower
# EVIDENCE_SUFFICIENT_TOP_SCORE / EVIDENCE_PARTIAL_TOP_SCORE when working
# with short Vietnamese clauses (default 0.70 / 0.40 is calibrated for
# dense English text). Leave blank to fall back to built-in defaults.
EVIDENCE_SUFFICIENT_TOP_SCORE=
EVIDENCE_PARTIAL_TOP_SCORE=
EVIDENCE_MINIMUM_SCORE_GAP=
EVIDENCE_MINIMUM_INDEPENDENT_SOURCES=
EVIDENCE_REQUIRE_CITATION_METADATA=
